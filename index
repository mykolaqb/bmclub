<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Business Management Club · University of Łódź</title>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:         hsl(240 6% 7%);
      --surface:    hsl(240 8% 10%);
      --card:       hsl(240 9% 12%);
      --border:     hsl(240 8% 18%);
      --fg:         hsl(44 22% 90%);
      --muted:      hsl(240 4% 55%);
      --navy:       hsl(232 60% 25%);
      --navy-glow:  hsl(230 70% 38%);
      --accent:     hsl(39 45% 60%);
      --accent-glow:hsl(39 60% 72%);
      --accent-fg:  hsl(240 6% 7%);
      --radius:     0.75rem;
      --grad-hero:  radial-gradient(ellipse 80% 55% at 50% 0%, hsl(232 60% 25% / 0.45) 0%, transparent 65%),
                    radial-gradient(ellipse 50% 35% at 85% 90%, hsl(39 45% 60% / 0.12) 0%, transparent 60%);
      --grad-gold:  linear-gradient(135deg, hsl(39 60% 72%), hsl(39 45% 55%));
      --grad-navy:  linear-gradient(135deg, hsl(232 60% 25%), hsl(230 70% 38%));
    }

    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--fg);
      font-family: Raleway, ui-sans-serif, system-ui, sans-serif;
      font-weight: 400;
      line-height: 1.6;
      overflow-x: hidden;
    }
    ::selection { background: hsl(39 45% 60% / 0.35); color: var(--fg); }

    /* ─── TYPOGRAPHY ─── */
    .font-display {
      font-family: "Archivo Black", "Arial Black", sans-serif;
      letter-spacing: -0.01em;
    }
    .text-gold {
      background: var(--grad-gold);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    /* ─── NAV ─── */
    nav {
      position: sticky; top: 0; z-index: 50;
      border-bottom: 1px solid hsl(240 8% 18% / 0.6);
      background: hsl(240 6% 7% / 0.75);
      backdrop-filter: blur(20px);
    }
    .nav-inner {
      max-width: 72rem; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1rem 1.5rem;
    }
    .nav-brand {
      display: flex; align-items: center; gap: 0.625rem;
      text-decoration: none;
    }
    .nav-brand img { width: 2rem; height: 2rem; object-fit: contain; }
    .nav-brand span {
      font-family: "Archivo Black", sans-serif;
      font-size: 0.875rem; letter-spacing: 0.1em;
      color: var(--fg);
    }
    .nav-li {
      font-size: 0.75rem; font-weight: 500;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--muted); text-decoration: none;
      position: relative; display: inline-block;
      transition: color 0.2s;
    }
    .nav-li::after {
      content: ""; position: absolute; left: 0; bottom: 0;
      height: 1px; width: 100%;
      background: var(--accent);
      transform: scaleX(0); transform-origin: right;
      transition: transform 0.3s;
    }
    .nav-li:hover { color: var(--accent); }
    .nav-li:hover::after { transform: scaleX(1); transform-origin: left; }

    /* ─── HERO ─── */
    header {
      position: relative; overflow: hidden;
      border-bottom: 1px solid hsl(240 8% 18% / 0.6);
    }
    .hero-grad {
      position: absolute; inset: 0;
      background: var(--grad-hero);
      pointer-events: none;
    }
    .bg-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(hsl(240 8% 18% / 0.5) 1px, transparent 1px),
        linear-gradient(90deg, hsl(240 8% 18% / 0.5) 1px, transparent 1px);
      background-size: 60px 60px;
      mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, black 0%, transparent 75%);
      pointer-events: none;
      opacity: 0.4;
    }
    .diamond-big {
      position: absolute; pointer-events: none;
      right: -80px; top: 2.5rem;
      width: 420px; height: 420px;
      border: 1px solid hsl(39 45% 60% / 0.6);
      background: var(--grad-navy);
      transform: rotate(45deg);
      animation: diamondSpin 14s ease-in-out infinite;
    }
    .diamond-sm {
      position: absolute; pointer-events: none;
      left: -5rem; bottom: -3.75rem;
      width: 10rem; height: 10rem;
      border: 1px solid hsl(39 45% 60% / 0.4);
      background: hsl(39 60% 72% / 0.2);
      transform: rotate(45deg);
      animation: floatSlow 6s ease-in-out infinite;
    }
    @keyframes diamondSpin {
      0%, 100% { transform: rotate(45deg) scale(1); }
      50%       { transform: rotate(50deg) scale(1.03); }
    }
    @keyframes floatSlow {
      0%, 100% { transform: rotate(45deg) translateY(0); }
      50%       { transform: rotate(45deg) translateY(-12px); }
    }
    .hero-inner {
      position: relative; max-width: 72rem; margin: 0 auto;
      padding: 7rem 1.5rem 10rem;
    }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 0.5rem;
      border: 1px solid hsl(39 45% 60% / 0.4);
      background: hsl(39 45% 60% / 0.05);
      border-radius: 9999px; padding: 0.375rem 1rem;
      margin-bottom: 2rem;
      animation: fadeIn 0.6s ease-out both;
    }
    .badge-dot {
      width: 0.375rem; height: 0.375rem; border-radius: 50%;
      background: var(--accent);
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(0.8)} }
    .badge-text {
      font-size: 0.6875rem; font-weight: 600;
      letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--accent);
    }
    h1 {
      font-family: "Archivo Black", sans-serif;
      font-size: clamp(3rem, 7vw, 5.5rem);
      line-height: 0.95; letter-spacing: -0.01em;
      text-transform: uppercase; color: var(--fg);
      margin-bottom: 2rem;
      animation: fadeIn 0.6s 0.1s ease-out both;
    }
    .hero-lead {
      margin-top: 2rem; max-width: 36rem;
      font-size: 1rem; line-height: 1.7;
      color: var(--muted);
      animation: fadeIn 0.6s 0.2s ease-out both;
    }
    .hero-meta {
      margin-top: 3rem; display: flex; flex-wrap: wrap; gap: 1.5rem 2rem;
      animation: fadeIn 0.6s 0.3s ease-out both;
    }
    .hero-meta-item {
      display: flex; align-items: center; gap: 0.625rem;
      font-size: 0.875rem; color: var(--muted);
    }
    .hero-meta-dot {
      width: 0.25rem; height: 0.25rem; border-radius: 50%;
      background: var(--accent); flex-shrink: 0;
    }

    /* ─── MARQUEE ─── */
    .marquee-strip {
      border-top: 1px solid hsl(240 8% 18% / 0.6);
      background: hsl(240 8% 10% / 0.4);
      padding: 0.75rem 0;
      overflow: hidden;
    }
    .marquee-track {
      display: flex; width: max-content;
      animation: marquee 25s linear infinite;
    }
    .marquee-item {
      display: flex; align-items: center; gap: 3rem;
      padding: 0 3rem;
      font-size: 0.75rem; letter-spacing: 0.3em;
      text-transform: uppercase; color: var(--muted);
      white-space: nowrap;
    }
    .marquee-gem { color: var(--accent); font-size: 0.6rem; }
    @keyframes marquee {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }

    /* ─── MAIN LAYOUT ─── */
    main { max-width: 72rem; margin: 0 auto; padding: 0 1.5rem; }
    section {
      border-bottom: 1px solid hsl(240 8% 18% / 0.6);
      padding: 6rem 0 7rem;
      opacity: 0; transform: translateY(20px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    section.visible { opacity: 1; transform: translateY(0); }

    .sec-label {
      margin-bottom: 0.75rem;
      font-size: 0.625rem; font-weight: 600;
      letter-spacing: 0.25em; text-transform: uppercase;
      color: var(--accent);
    }
    h2 {
      font-family: "Archivo Black", sans-serif;
      font-size: clamp(1.875rem, 4vw, 3rem);
      line-height: 1.05; letter-spacing: -0.01em;
      text-transform: uppercase; color: var(--fg);
    }
    .sec-lead {
      margin-top: 1.25rem; max-width: 42rem;
      font-size: 1rem; line-height: 1.7; color: var(--muted);
    }

    /* ─── CARDS (shared) ─── */
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      position: relative; overflow: hidden;
      transition: transform 0.2s, border-color 0.2s;
    }
    .card:hover { transform: translateY(-6px); }
    .card-top-line {
      position: absolute; inset-x: 0; top: 0; height: 1px;
      background: linear-gradient(to right, var(--accent), hsl(39 45% 60% / 0.4), transparent);
    }

    /* ─── STORY CARDS ─── */
    .story-grid {
      margin-top: 3rem;
      display: grid; gap: 1.25rem; grid-template-columns: repeat(3,1fr);
    }
    .story-card { padding: 1.75rem; }
    .story-card-num {
      display: flex; align-items: center; gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .diamond-xs {
      display: inline-block; width: 0.75rem; height: 0.75rem;
      border: 1px solid hsl(39 45% 60% / 0.6);
      background: var(--grad-navy);
      transform: rotate(45deg);
    }
    .story-num-label {
      font-family: "Archivo Black", sans-serif;
      font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--accent);
    }
    .story-card h3 {
      font-family: "Archivo Black", sans-serif;
      font-size: 1.125rem; text-transform: uppercase; color: var(--fg);
      margin-bottom: 0.75rem;
    }
    .story-card p { font-size: 0.875rem; line-height: 1.7; color: var(--muted); }

    /* ─── STEPS GRID ─── */
    .steps-grid {
      margin-top: 3rem;
      display: grid; gap: 1px;
      grid-template-columns: 1fr 1fr;
      overflow: hidden;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      background: var(--border);
    }
    .step-cell {
      background: var(--card); padding: 1.75rem;
      display: flex; gap: 1.25rem; align-items: flex-start;
      transition: background 0.2s;
    }
    .step-cell:hover { background: var(--surface); }
    .step-circle {
      flex-shrink: 0;
      width: 3rem; height: 3rem;
      border-radius: 50%;
      border: 1px solid hsl(39 45% 60% / 0.4);
      background: hsl(39 45% 60% / 0.05);
      display: flex; align-items: center; justify-content: center;
      font-family: "Archivo Black", sans-serif;
      font-size: 0.875rem; color: var(--accent);
      transition: background 0.2s, color 0.2s;
    }
    .step-cell:hover .step-circle {
      background: var(--accent); color: var(--accent-fg);
    }
    .step-cell h3 {
      font-family: "Archivo Black", sans-serif;
      font-size: 1rem; text-transform: uppercase;
      letter-spacing: 0.04em; color: var(--fg); margin-bottom: 0.375rem;
    }
    .step-cell p { font-size: 0.875rem; line-height: 1.7; color: var(--muted); }

    /* ─── GUEST GRID ─── */
    .guest-grid {
      margin-top: 3rem;
      display: grid; gap: 0.75rem; grid-template-columns: repeat(3, 1fr);
    }
    .guest-card {
      border: 1px solid var(--border);
      background: var(--card); border-radius: var(--radius);
      padding: 1.25rem;
      display: flex; align-items: center; gap: 0.5rem;
      transition: transform 0.2s, border-color 0.2s;
    }
    .guest-card:hover { transform: translateY(-4px); border-color: hsl(39 45% 60% / 0.5); }
    .guest-card .diamond-xs { flex-shrink: 0; }
    .guest-name { font-size: 0.875rem; font-weight: 600; color: var(--fg); }

    /* ─── AFTERPARTY CARDS ─── */
    .ap-grid {
      margin-top: 3rem;
      display: grid; gap: 1.25rem; grid-template-columns: repeat(3,1fr);
    }
    .ap-card { padding: 1.75rem; overflow: hidden; }
    .ap-diamond {
      position: absolute; right: -2.5rem; top: -2.5rem;
      width: 8rem; height: 8rem;
      border: 1px solid hsl(232 60% 25% / 0.3);
      background: hsl(232 60% 25% / 0.2);
      transform: rotate(45deg);
      transition: transform 0.5s;
    }
    .ap-card:hover .ap-diamond { transform: rotate(60deg); }
    .ap-tag {
      position: relative; display: inline-block;
      margin-bottom: 1rem;
      border: 1px solid hsl(39 60% 72% / 0.4);
      background: hsl(232 60% 25% / 0.2);
      border-radius: 9999px; padding: 0.25rem 0.75rem;
      font-size: 0.625rem; font-weight: 600;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: hsl(39 60% 72%);
    }
    .ap-card h3 {
      position: relative;
      font-family: "Archivo Black", sans-serif;
      font-size: 1.125rem; text-transform: uppercase; color: var(--fg);
      margin-bottom: 0.75rem;
    }
    .ap-card p { position: relative; font-size: 0.875rem; line-height: 1.7; color: var(--muted); }

    /* ─── STANDARDS ─── */
    .std-list { margin-top: 3rem; display: flex; flex-direction: column; gap: 0.75rem; }
    .std-item {
      display: flex; align-items: center; gap: 1rem;
      border: 1px solid var(--border); background: var(--card);
      border-radius: var(--radius); padding: 1.25rem 1.5rem;
      transition: border-color 0.2s, background 0.2s;
    }
    .std-item:hover { border-color: hsl(39 45% 60% / 0.4); background: var(--surface); }
    .std-diamond {
      display: inline-block; width: 0.625rem; height: 0.625rem;
      border: 1px solid hsl(39 45% 60% / 0.6);
      background: var(--grad-navy);
      transform: rotate(45deg); flex-shrink: 0;
      transition: transform 0.2s;
    }
    .std-item:hover .std-diamond { transform: rotate(90deg); }
    .std-item p { font-size: 0.875rem; color: var(--fg); }

    /* ─── SKILLS CARDS ─── */
    .skills-grid {
      margin-top: 3rem;
      display: grid; gap: 1.25rem;
      grid-template-columns: repeat(4, 1fr);
    }
    .skill-card { padding: 1.5rem; }
    .skill-icon {
      width: 2.75rem; height: 2.75rem; border-radius: 0.5rem;
      background: var(--grad-navy);
      box-shadow: 0 20px 60px -20px hsl(232 60% 25% / 0.5);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 1rem; color: hsl(39 60% 72%);
    }
    .skill-card h3 {
      font-family: "Archivo Black", sans-serif;
      font-size: 0.875rem; text-transform: uppercase;
      letter-spacing: 0.04em; color: var(--fg); margin-bottom: 0.5rem;
    }
    .skill-card p { font-size: 0.875rem; line-height: 1.7; color: var(--muted); }

    /* ─── CTA ─── */
    .cta-block {
      position: relative; margin: 4rem 0;
      overflow: hidden; border-radius: 1rem;
      border: 1px solid var(--border);
      background: var(--grad-navy);
      padding: 2.5rem 4rem;
    }
    .cta-diamond-big {
      position: absolute; right: -5rem; top: -5rem;
      width: 20rem; height: 20rem;
      border: 1px solid hsl(39 45% 60% / 0.4);
      background: hsl(232 60% 25% / 0.4);
      transform: rotate(45deg);
      animation: diamondSpin 14s ease-in-out infinite;
    }
    .cta-diamond-sm {
      position: absolute; left: -2.5rem; bottom: -2.5rem;
      width: 10rem; height: 10rem;
      border: 1px solid hsl(39 45% 60% / 0.3);
      background: hsl(39 60% 72% / 0.2);
      transform: rotate(45deg);
      animation: floatSlow 6s ease-in-out infinite;
    }
    .cta-inner { position: relative; max-width: 32rem; }
    .cta-label {
      margin-bottom: 0.75rem; font-size: 0.625rem; font-weight: 600;
      letter-spacing: 0.25em; text-transform: uppercase;
      color: hsl(39 60% 72%);
    }
    .cta-block h2 {
      font-size: clamp(2.25rem, 4vw, 3.75rem);
      line-height: 1; color: hsl(44 30% 95%);
    }
    .cta-block p {
      margin-top: 1.5rem; max-width: 32rem;
      font-size: 1rem; line-height: 1.7;
      color: hsl(44 30% 95% / 0.75);
    }
    .cta-btn {
      margin-top: 2.5rem; display: inline-flex; align-items: center; gap: 0.75rem;
      border-radius: 0.5rem;
      background: var(--grad-gold);
      box-shadow: 0 10px 40px -10px hsl(39 45% 60% / 0.35);
      padding: 1rem 1.75rem;
      font-size: 0.875rem; font-weight: 600;
      color: var(--accent-fg); text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .cta-btn:hover { transform: scale(1.02); box-shadow: 0 14px 44px -8px hsl(39 45% 60% / 0.45); }
    .cta-btn svg { width: 1rem; height: 1rem; }

    /* ─── FOOTER ─── */
    footer {
      border-top: 1px solid var(--border);
      background: hsl(240 8% 10% / 0.4);
    }
    .footer-inner {
      max-width: 72rem; margin: 0 auto;
      display: flex; flex-direction: column; align-items: center; gap: 0.75rem;
      padding: 3rem 1.5rem; text-align: center;
    }
    .footer-brand {
      display: flex; align-items: center; gap: 0.625rem;
    }
    .footer-brand img { width: 2rem; height: 2rem; object-fit: contain; }
    .footer-brand span {
      font-family: "Archivo Black", sans-serif;
      font-size: 0.875rem; letter-spacing: 0.1em;
      color: var(--accent);
    }
    footer p { font-size: 0.75rem; color: var(--muted); }

    /* ─── ANIMATIONS ─── */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 900px) {
      .story-grid { grid-template-columns: 1fr; }
      .steps-grid { grid-template-columns: 1fr; }
      .ap-grid { grid-template-columns: 1fr; }
      .skills-grid { grid-template-columns: 1fr 1fr; }
      .guest-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 600px) {
      .hero-inner { padding: 4rem 1rem 6rem; }
      .skills-grid { grid-template-columns: 1fr; }
      .guest-grid { grid-template-columns: 1fr; }
      .cta-block { padding: 2rem 1.5rem; }
    }
  </style>
</head>
